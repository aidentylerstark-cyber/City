{
  "name": "citylink",
  "version": "0.1.0",
  "private": true,
  "description": "City Link \u2014 the management system for Second Life communities.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "setup": "npm run db:push && npm run db:seed",
    "sl:deliver": "tsx --env-file-if-exists=.env scripts/sl-object.ts deliver",
    "sl:deed": "tsx --env-file-if-exists=.env scripts/sl-object.ts deed",
    "sl:heartbeat": "tsx --env-file-if-exists=.env scripts/sl-object.ts heartbeat",
    "health": "curl -s localhost:3000/api/health"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
