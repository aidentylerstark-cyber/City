# --- Database -------------------------------------------------------------
# Port 5433 matches docker-compose.yml, so it does not collide with a local 5432.
DATABASE_URL="postgresql://citylink:citylink@localhost:5433/citylink?schema=public"

# --- Session / crypto -----------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-48"

# --- Second Life bridge ---------------------------------------------------
# Shared secret burned into the in-world LSL objects. Every request from an
# object is HMAC-signed with this. Rotate it and you must re-deed the objects.
SL_BRIDGE_SECRET="change-me-generate-with-openssl-rand-base64-48"

# Public base URL the LSL objects call back to (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Max clock skew (seconds) allowed on a signed LSL request.
SL_BRIDGE_MAX_SKEW="120"

# --- Optional: name resolution -------------------------------------------
# Leave unset to use the built-in resolver order (local cache -> avatar
# lookup service -> in-world claim).
SL_NAME_LOOKUP_URL=""
